# Local development
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Playwright e2e (against smoke DB API on :3011):
# NEXT_PUBLIC_API_URL=http://localhost:3011/api
# Then: npm run test:e2e:inventory
#       npm run test:e2e:dashboard

# Sentry (optional locally — leave blank to disable)
# Create a Next.js project at https://sentry.io → copy DSN
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=development

# Production (Droplet): https://api.marinapizzas.com.au/api

# NextOrder embed (Benny Boy's online ordering iframe)
# NEXT_PUBLIC_NEXTORDER_URL=https://benny-boys-pizza-wantirna-south.nextorder.com/
